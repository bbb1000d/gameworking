{
  "name": "@rogue/server",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "jest --runInBand",
    "db:migrate": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.3.1",
    "@fastify/cors": "10.1.0",
    "@prisma/client": "5.10.2",
    "@rogue/shared": "workspace:^",
    "argon2": "0.31.2",
    "fastify": "4.26.1",
    "fastify-plugin": "4.5.1",
    "fastify-sensible": "5.5.0",
    "jsonwebtoken": "9.0.2",
    "nanoid": "5.0.6",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "20.11.19",
    "@types/supertest": "2.0.16",
    "jest": "29.7.0",
    "prisma": "5.10.2",
    "supertest": "6.3.4",
    "ts-jest": "29.1.1",
    "tsup": "7.2.0",
    "tsx": "4.7.1",
    "typescript": "5.3.3"
  }
}
